#!/bin/bash -l
#PBS -N cov256-recovery
#PBS -q autox
#PBS -P CFP04-SF-109
#PBS -l select=1:ncpus=36:mem=240gb:ngpus=1:gpu_model=A40
#PBS -l walltime=03:00:00
#PBS -j oe
set -euo pipefail
module load Miniconda3/24.7.1-0 git/2.40.0
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate /scratch/e1538633/liuyi/envs/sign-baseline
export PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONHASHSEED=0 PYTHONNOUSERSITE=1
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 HABITAT_SIM_LOG=quiet MAGNUM_LOG=quiet
cd /scratch/e1538633/liuyi/SIGN-inference-coverage256
: "${RECOVERY_CHECKPOINT_BATCH:?Specify immutable batch directory}"
case "${RECOVERY_SUITE:?Choose rule or qwen}" in
 rule) python scripts/run_rule_recovery.py --batch "$RECOVERY_CHECKPOINT_BATCH" ;;
 qwen) python scripts/run_active_recovery.py --batch "$RECOVERY_CHECKPOINT_BATCH" ;;
 *) echo 'Unknown recovery suite' >&2; exit 1 ;;
esac
