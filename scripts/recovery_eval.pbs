#!/bin/bash -l
#PBS -N sign-recovery
#PBS -q autox
#PBS -P CFP04-SF-109
#PBS -l select=1:ncpus=36:mem=240gb:ngpus=1:gpu_model=A40
#PBS -l walltime=02:00:00
#PBS -j oe
set -euo pipefail
module load Miniconda3/24.7.1-0 git/2.40.0
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate /scratch/e1538633/liuyi/envs/sign-baseline
export PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONHASHSEED=0 PYTHONNOUSERSITE=1
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 HABITAT_SIM_LOG=quiet MAGNUM_LOG=quiet
cd /scratch/e1538633/liuyi/SIGN-inference-harness
: "${RECOVERY_BATCH:?Specify frozen manifest directory}"
if [[ "${RECOVERY_STAGE:-pilot}" == "full" ]]; then
    python scripts/run_recovery_suite.py --batch "$RECOVERY_BATCH" --stage full --full
else
    python scripts/run_recovery_suite.py --batch "$RECOVERY_BATCH" --stage pilot
fi
