#!/bin/bash -l
#PBS -N qwen-single-speed
#PBS -o /scratch/e1538633/liuyi/logs/qwen_single_latency_20261028/benchmark.pbs.log
#PBS -l walltime=02:00:00
#PBS -q autox
#PBS -P CFP04-SF-109
#PBS -l select=1:ncpus=36:mem=240gb:ngpus=1:gpu_model=A40
#PBS -j oe
set -euo pipefail
cd /scratch/e1538633/liuyi/SIGN-qwen-topdown-judge
module load Miniconda3/24.7.1-0
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate /scratch/e1538633/liuyi/envs/qwen35
export PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
support=/scratch/e1538633/liuyi/logs/qwen_single_latency_20261028
nvidia-smi --query-gpu=name,uuid,driver_version,memory.total --format=csv > "$support/gpu.csv"
python "$support/run_all.py"
