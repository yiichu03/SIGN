#!/bin/bash -l
#PBS -N abc-val
#PBS -o /scratch/e1538633/liuyi/logs/qwen_ablation_20261029/milestone_eval.pbs.log
#PBS -l walltime=04:00:00
#PBS -q autox
#PBS -P CFP04-SF-109
#PBS -l select=1:ncpus=36:mem=240gb:ngpus=1:gpu_model=A40
#PBS -j oe
set -euo pipefail
cd /scratch/e1538633/liuyi/SIGN-coverage-eval
module load Miniconda3/24.7.1-0
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate /scratch/e1538633/liuyi/envs/sign-baseline
export PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONHASHSEED=0 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
export HABITAT_SIM_LOG=quiet MAGNUM_LOG=quiet
nvidia-smi --query-gpu=name,uuid,driver_version,memory.total --format=csv
python /scratch/e1538633/liuyi/logs/qwen_ablation_20261029/evaluate_milestone.py
