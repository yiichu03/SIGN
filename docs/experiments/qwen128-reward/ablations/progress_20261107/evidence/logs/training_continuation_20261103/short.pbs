#!/bin/bash -l
#PBS -N sign-cont-short
#PBS -l walltime=01:00:00
#PBS -q autox
#PBS -P CFP04-SF-109
#PBS -l select=1:ncpus=36:mem=240gb:ngpus=1:gpu_model=A40
#PBS -j oe
set -euo pipefail
module load Miniconda3/24.7.1-0
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate /scratch/e1538633/liuyi/envs/sign-baseline
export PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONHASHSEED=0 PYTHONNOUSERSITE=1
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 HABITAT_SIM_LOG=quiet MAGNUM_LOG=quiet
support=/scratch/e1538633/liuyi/logs/training_continuation_20261103
for continuation_case in coverage256 coverage32 C A B qwen01; do
    python "$support/run_case.py" "$continuation_case" short
done
